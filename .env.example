# --- Docker compose (dev) ---
POSTGRES_USER=ragnex
POSTGRES_PASSWORD=ragnex
POSTGRES_DB=ragnex

# MinIO (dev)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Backend runtime ---
# Prefer DATABASE_URL in the form: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=postgresql+asyncpg://ragnex:ragnex@localhost:5432/ragnex

REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
# Required by OpenSearch Docker image bootstrap (dev only)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=DevOnlyAdmin123!

# S3-compatible storage configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ragnex
S3_REGION=us-east-1

# Security
# Signs login tokens; the app refuses to start without a random value of 32+ bytes.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=14

# Limits
MAX_UPLOAD_MB=100

# Optional: LLM / embedding providers (to be used later)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=
