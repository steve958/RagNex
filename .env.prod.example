# Settings for docker-compose.prod.yml. Copy to .env.prod and fill in the secrets:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Never commit .env.prod.

# --- Required secrets (no defaults; compose refuses to start without them) ---------------
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
# Required by the OpenSearch image at first start (min. 8 chars, upper/lower/digit/special).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# --- Public port -------------------------------------------------------------------------
RAGNEX_HTTP_PORT=8080

# --- Models ------------------------------------------------------------------------------
# Default: Ollama running on the Docker host. Pull the models there first:
#   ollama pull llama3 && ollama pull bge-m3
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=llama3
# Set to the model's real context size (prompt + answer); chat prompts are trimmed to fit.
LLM_CONTEXT_WINDOW=8192
LLM_MAX_TOKENS=2048
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# Must match the embedding model's output size. Changing it later requires reindexing.
EMBEDDING_DIMENSION=1024
# For LLM_PROVIDER/EMBEDDING_PROVIDER=openai or vllm:
OPENAI_API_KEY=
VLLM_BASE_URL=

# Workspace owners can override the model settings above in Settings. They can only point
# them at endpoints listed here (JSON list). Empty = the server's endpoints only. Only list
# trusted endpoints: any URL here can be called by the server on a tenant's behalf.
# TENANT_MODEL_BASE_URLS=["http://gpu-box:11434"]

# --- Optional tuning ---------------------------------------------------------------------
# POSTGRES_USER=ragnex
# POSTGRES_DB=ragnex
# MINIO_ROOT_USER=ragnex
# MAX_UPLOAD_SIZE_MB=100
# API_WORKERS=2
# WORKER_CONCURRENCY=2
# OPENSEARCH_HEAP=1g
# RAGNEX_VERSION=latest
