# Rendered by the nginx image's envsubst step: only ${RAGNEX_*} variables are replaced;
# nginx's own variables ($host, $uri, ...) are left as-is.

upstream ragnex_api {
    server ${RAGNEX_API_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    client_max_body_size ${RAGNEX_MAX_UPLOAD_MB}m;

    # Client IP, used by the API's per-IP rate limits (e.g. 20 logins/minute). Only a request
    # from RAGNEX_TRUSTED_PROXY (your TLS proxy) may name the client in X-Forwarded-For;
    # from anyone else the header is ignored, so clients can't pick their own IP.
    set_real_ip_from ${RAGNEX_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Container liveness probe.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://ragnex_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace, don't append: the API trusts this header from nginx, so it must hold
        # only the client IP worked out above, never addresses the client sent.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Chat answers stream as server-sent events: pass bytes through as they arrive.
        proxy_buffering off;
        proxy_cache off;
        # Long generations and large uploads.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Hashed build assets never change: cache them for good.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: unknown paths render index.html, which must never be cached
    # (it points at the current asset hashes).
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
